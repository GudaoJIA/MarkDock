# Absolute service data directory; default: ~/.config/markdock
# Stores pins and private .markdock-auth.json credentials; keep outside the source tree.
# Initialize once with: bun run auth:password
# Resource rules belong to each workspace.
MARKDOCK_DATA_DIR=

# JSON array of container-visible data mount directories. Restart after changing.
# When set, all workspace browsing/opening/pinning is restricted to these roots.
# Unset: local development allows manual paths; []: deny all workspace roots.
# Example: MARKDOCK_WORKSPACE_ROOTS=["/workspaces/blogs","/workspaces/notes"]
MARKDOCK_WORKSPACE_ROOTS=

# Optional single external HTTPS origin; no trailing slash/path/query.
# Requires nonempty WORKSPACE_ROOTS and an absolute DATA_DIR. HTTPS terminates
# at your reverse proxy, which must preserve the external Host (including port).
# Example: MARKDOCK_PUBLIC_ORIGIN=https://notes.example.com
MARKDOCK_PUBLIC_ORIGIN=

# Production only: non-loopback bind requires the explicit HTTPS origin above.
# Do not expose the backend directly; restrict it to your proxy network.
MARKDOCK_HOST=127.0.0.1
PORT=3000
