# Copy to .env.docker and replace these values. No password belongs in this file.
MARKDOCK_PUBLIC_ORIGIN=https://notes.example.com
# Existing host directories, owned/writable by the selected UID/GID.
MARKDOCK_CONFIG_PATH=/srv/markdock/config
MARKDOCK_DOCUMENTS_PATH=/srv/markdock/documents
MARKDOCK_UID=1000
MARKDOCK_GID=1000
# Bind only to host loopback; put an HTTPS reverse proxy in front.
MARKDOCK_HTTP_PORT=3000
