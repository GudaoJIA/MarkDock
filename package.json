{
  "name": "markdock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && bun run build:admin",
    "auth:password": "bun scripts/auth-password.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "lint": "biome check src biome.jsonc components.json tsconfig.json eslint.config.mjs next.config.ts postcss.config.mjs && eslint",
    "lint:fix": "biome check src biome.jsonc components.json tsconfig.json eslint.config.mjs next.config.ts postcss.config.mjs --fix --unsafe",
    "preview": "next build && node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "test:workspace": "bun test tests/workspace",
    "typecheck": "tsc --noEmit",
    "build:admin": "bun build scripts/auth-password.ts --target=node --format=esm --outfile=.next/admin/auth-password.mjs"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.39",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/floating": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.3.5",
    "@platejs/list": "^53.1.3",
    "@platejs/markdown": "^53.3.12",
    "@platejs/media": "^53.1.4",
    "@platejs/slash-command": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@udecode/cn": "^52.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.42.0",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-decode-string": "2.0.1",
    "next": "16.3.4",
    "platejs": "^53.3.11",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/parser": "8.56.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "ultracite": "7.8.3"
  },
  "packageManager": "bun@1.3.3"
}
